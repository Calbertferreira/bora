# Banco PostgreSQL exclusivo do BORA no Neon
DATABASE_URL=postgresql://usuario:senha@host/bora?sslmode=require

# Autenticação (gere um segredo longo e exclusivo em produção)
BETTER_AUTH_SECRET=substitua-por-um-segredo-seguro
BETTER_AUTH_URL=http://localhost:3000

# Opcionais: habilitam o botão "Continuar com Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
